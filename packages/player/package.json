{
  "name": "@powermove/player",
  "license": "AGPL-3.0-or-later",
  "version": "0.0.0",
  "private": true,
  "description": "Powermove web player and SVG adapter, bundled for browsers from the Electron app's player sources at a pinned commit.",
  "type": "module",
  "exports": {
    "./player": {
      "types": "./dist/player.d.ts",
      "default": "./dist/player.js"
    },
    "./svg-player": {
      "types": "./dist/svg-player.d.ts",
      "default": "./dist/svg-player.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node build.mjs"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "three": "0.180.0",
    "zod": "4.6.5"
  }
}
