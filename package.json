{
  "name": "powermove-monorepo",
  "private": true,
  "description": "Powermove: an AI-native motion editor for macOS, its website, and shared packages.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --cwd apps/desktop dev",
    "dev:web": "bun run --cwd apps/website dev",
    "build": "bun run --filter '*' build",
    "test": "bun run --filter '*' test",
    "typecheck": "bun run --filter '*' typecheck",
    "test:e2e": "bun run --cwd apps/desktop test:e2e",
    "dist:mac": "bun run --cwd apps/desktop dist:mac",
    "dist:release": "bun run --cwd apps/desktop dist:release"
  },
  "trustedDependencies": [
    "@anthropic-ai/claude-code",
    "@powermove/macos-haptics",
    "electron",
    "esbuild",
    "ffmpeg-static"
  ],
  "engines": {
    "bun": ">=1.3"
  },
  "packageManager": "bun@1.3.14"
}
