{
  "name": "powermove-monorepo",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "description": "Powermove: an AI-native motion editor for macOS, its website, and shared packages.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:www": "bun run --cwd apps/www dev",
    "build": "bun run --filter '*' build",
    "test": "bun run --filter '*' test",
    "typecheck": "bun run --filter '*' typecheck"
  },
  "trustedDependencies": [
    "@anthropic-ai/claude-code",
    "@powermove/macos-haptics",
    "esbuild"
  ],
  "engines": {
    "bun": ">=1.3"
  },
  "packageManager": "bun@1.3.14"
}
