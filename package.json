{
  "name": "powermove",
  "version": "1.0.0",
  "private": true,
  "description": "A GPU-native, AI-authored motion editor for macOS.",
  "main": "out/main/index.js",
  "scripts": {
    "test": "vitest run",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "dist:release": "node scripts/release-mac.mjs",
    "preview": "electron-vite preview",
    "test:e2e": "playwright test",
    "typecheck": "svelte-check --tsconfig ./tsconfig.web.json && tsc --noEmit -p tsconfig.node.json",
    "test:unit": "vitest run"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "@playwright/test": "1.62.1",
    "@sveltejs/vite-plugin-svelte": "6.2.4",
    "@types/node": "26.3.0",
    "electron": "44.0.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "happy-dom": "20.11.6",
    "svelte": "5.56.10",
    "svelte-check": "4.7.6",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/claude-code": "2.1.261",
    "@motion-core/motion-gpu": "0.15.1",
    "@openai/codex": "0.153.4",
    "@powermove/macos-haptics": "file:native/macos-haptics",
    "esbuild": "0.25.12",
    "ffmpeg-static": "5.3.0"
  }
}
