// m152 SDFTextRenderStep and source-over solid paint. Atlas is R8Unorm.
layout(set=0,binding=0) uniform Params { float4 u[9]; };
layout(set=0,binding=2) sampler2D atlas;
layout(location=0) in float2 textureCoords;
layout(location=1) in float2 unormTexCoords;
void main() {
    sk_FragColor=half4(u[8])*sdf_text_coverage_fn(sample(atlas,textureCoords).r,half2(0),unormTexCoords);
}
