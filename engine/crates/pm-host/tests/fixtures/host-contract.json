{
  "description": "Contract 14 invariant 9: every host serves engine requests the same way. Run by pm-host (tests/contract.rs) and by Electron main (apps/desktop/src/main/engine/host-contract.test.ts). $name values are substituted from earlier steps' saves; paths are relative to the test's temporary root, where 'Powermove' is the automatic output folder and 'cache' the cache directory. Global memory is 10000 bytes.",
  "steps": [
    { "op": "request", "process": "job", "port": 1, "session": null,
      "request": { "type": "mintHandle", "kind": { "kind": "cache", "cache": "renderCache" }, "session": 1 },
      "expect": { "response": "handle" }, "save": { "cacheHandle": "handle" } },
    { "op": "request", "process": "job", "port": 1, "session": null,
      "request": { "type": "resolveHandle", "handle": "$cacheHandle", "session": 1 },
      "expect": { "response": "handleResolved", "fields": { "access": "readWrite" }, "pathEndsWith": "cache/Render Cache" } },
    { "op": "request", "process": "job", "port": 1, "session": null,
      "request": { "type": "resolveHandle", "handle": "$cacheHandle", "session": 2 },
      "expect": { "error": "capabilityRejected" } },
    { "op": "request", "process": "interactive", "port": 2, "session": null,
      "request": { "type": "resolveHandle", "handle": "$cacheHandle", "session": 1 },
      "expect": { "error": "capabilityRejected" } },
    { "op": "request", "process": "job", "port": 1, "session": null,
      "request": { "type": "resolveHandle", "handle": "00000000000000000000000000000000", "session": 1 },
      "expect": { "error": "capabilityRejected" } },
    { "op": "request", "process": "job", "port": 1, "session": null,
      "request": { "type": "mintHandle", "kind": { "kind": "outputWrite", "job": "j1" }, "session": 1 },
      "expect": { "error": "capabilityRejected" } },
    { "op": "request", "process": "job", "port": 1, "session": null,
      "request": { "type": "mintHandle", "kind": { "kind": "mediaRead", "asset": "missing" }, "session": 1 },
      "expect": { "error": "mediaOffline" } },
    { "op": "request", "process": "job", "port": 1, "session": null,
      "request": { "type": "mintHandle", "kind": { "kind": "projectStore" }, "session": 1 },
      "expect": { "error": "unsupported" } },

    { "op": "request", "process": "job", "port": 1, "session": 3,
      "request": { "type": "outputDestination", "job": "j1", "choice": { "kind": "agentAutomatic", "suggestedName": "../../etc/passwd", "extension": "mov" }, "overwrite": "uniqueName" },
      "expect": { "error": "invalidMessage" } },
    { "op": "request", "process": "job", "port": 1, "session": 3,
      "request": { "type": "outputDestination", "job": "j1", "choice": { "kind": "agentAutomatic", "suggestedName": "Cut", "extension": "mov" }, "overwrite": "replace" },
      "expect": { "error": "invalidMessage" } },
    { "op": "request", "process": "interactive", "port": 2, "session": 3,
      "request": { "type": "outputDestination", "job": "j1", "choice": { "kind": "agentAutomatic", "suggestedName": "Cut", "extension": "mov" }, "overwrite": "uniqueName" },
      "expect": { "error": "capabilityRejected" } },
    { "op": "request", "process": "job", "port": 1, "session": 3,
      "request": { "type": "outputDestination", "job": "j1", "choice": { "kind": "agentAutomatic", "suggestedName": "Cut", "extension": "mov" }, "overwrite": "uniqueName" },
      "expect": { "response": "outputDestination" }, "save": { "out1": "temporary" } },
    { "op": "request", "process": "job", "port": 1, "session": null,
      "request": { "type": "resolveHandle", "handle": "$out1", "session": 3 },
      "expect": { "response": "handleResolved", "fields": { "access": "write" }, "mode": 384, "pathMatches": "^Powermove/\\.powermove-[0-9a-f]{16}\\.part$" }, "save": { "out1Path": "path" } },
    { "op": "write", "path": "$out1Path", "bytes": 5 },
    { "op": "request", "process": "job", "port": 1, "session": 4,
      "request": { "type": "commitOutput", "job": "j1", "temporary": "$out1", "commit": true, "verification": { "codec": "prores", "frames": 24, "audioSamples": 0, "bytes": 5 } },
      "expect": { "error": "capabilityRejected" } },
    { "op": "request", "process": "job", "port": 1, "session": 3,
      "request": { "type": "commitOutput", "job": "j1", "temporary": "$out1", "commit": true, "verification": { "codec": "prores", "frames": 24, "audioSamples": 0, "bytes": 5 } },
      "expect": { "response": "outputCommitted", "pathEndsWith": "Powermove/Cut.mov" } },
    { "op": "exists", "path": "$out1Path", "expect": false },

    { "op": "request", "process": "job", "port": 1, "session": 3,
      "request": { "type": "outputDestination", "job": "j2", "choice": { "kind": "agentAutomatic", "suggestedName": "Cut", "extension": "mov" }, "overwrite": "uniqueName" },
      "expect": { "response": "outputDestination" }, "save": { "out2": "temporary" } },
    { "op": "request", "process": "job", "port": 1, "session": null,
      "request": { "type": "resolveHandle", "handle": "$out2", "session": 3 },
      "expect": { "response": "handleResolved" }, "save": { "out2Path": "path" } },
    { "op": "write", "path": "$out2Path", "bytes": 3 },
    { "op": "request", "process": "job", "port": 1, "session": 3,
      "request": { "type": "commitOutput", "job": "j2", "temporary": "$out2", "commit": true, "verification": { "codec": "prores", "frames": 1, "audioSamples": 0, "bytes": 3 } },
      "expect": { "response": "outputCommitted", "pathEndsWith": "Powermove/Cut (2).mov" } },

    { "op": "request", "process": "job", "port": 1, "session": 3,
      "request": { "type": "outputDestination", "job": "j3", "choice": { "kind": "agentAutomatic", "suggestedName": "Empty", "extension": "mp4" }, "overwrite": "uniqueName" },
      "expect": { "response": "outputDestination" }, "save": { "out3": "temporary" } },
    { "op": "request", "process": "job", "port": 1, "session": null,
      "request": { "type": "resolveHandle", "handle": "$out3", "session": 3 },
      "expect": { "response": "handleResolved" }, "save": { "out3Path": "path" } },
    { "op": "request", "process": "job", "port": 1, "session": 3,
      "request": { "type": "commitOutput", "job": "j3", "temporary": "$out3", "commit": true, "verification": { "codec": "h264", "frames": 1, "audioSamples": 0, "bytes": 0 } },
      "expect": { "error": "exportFailed" } },
    { "op": "exists", "path": "$out3Path", "expect": false },

    { "op": "request", "process": "job", "port": 1, "session": 3,
      "request": { "type": "outputDestination", "job": "j4", "choice": { "kind": "agentAutomatic", "suggestedName": "Unverified", "extension": "mp4" }, "overwrite": "uniqueName" },
      "expect": { "response": "outputDestination" }, "save": { "out4": "temporary" } },
    { "op": "request", "process": "job", "port": 1, "session": null,
      "request": { "type": "resolveHandle", "handle": "$out4", "session": 3 },
      "expect": { "response": "handleResolved" }, "save": { "out4Path": "path" } },
    { "op": "write", "path": "$out4Path", "bytes": 9 },
    { "op": "request", "process": "job", "port": 1, "session": 3,
      "request": { "type": "commitOutput", "job": "j4", "temporary": "$out4", "commit": true, "verification": null },
      "expect": { "error": "exportFailed" } },
    { "op": "exists", "path": "$out4Path", "expect": false },

    { "op": "request", "process": "job", "port": 1, "session": 3,
      "request": { "type": "outputDestination", "job": "j5", "choice": { "kind": "agentAutomatic", "suggestedName": "Cancelled", "extension": "mov" }, "overwrite": "uniqueName" },
      "expect": { "response": "outputDestination" }, "save": { "out5": "temporary" } },
    { "op": "request", "process": "job", "port": 1, "session": null,
      "request": { "type": "resolveHandle", "handle": "$out5", "session": 3 },
      "expect": { "response": "handleResolved" }, "save": { "out5Path": "path" } },
    { "op": "request", "process": "job", "port": 1, "session": 3,
      "request": { "type": "commitOutput", "job": "j5", "temporary": "$out5", "commit": false, "verification": null },
      "expect": { "response": "outputCommitted", "fields": { "path": null } } },
    { "op": "exists", "path": "$out5Path", "expect": false },

    { "op": "request", "process": "job", "port": 1, "session": null,
      "request": { "type": "hardwareSessions", "kind": "proResEncode", "delta": 3 },
      "expect": { "response": "hardwareSessions", "fields": { "held": 2 } } },
    { "op": "request", "process": "interactive", "port": 2, "session": null,
      "request": { "type": "hardwareSessions", "kind": "proResEncode", "delta": 1 },
      "expect": { "response": "hardwareSessions", "fields": { "held": 0 } } },
    { "op": "request", "process": "job", "port": 1, "session": null,
      "request": { "type": "hardwareSessions", "kind": "proResEncode", "delta": 0 },
      "expect": { "error": "invalidMessage" } },

    { "op": "initialLeases" },
    { "op": "request", "process": "job", "port": 1, "session": null,
      "request": { "type": "requestLease", "process": "job", "wanted": 9000, "reason": "requested" },
      "expect": { "response": "lease", "fields": { "bytes": 4000, "reason": "requested" } } },
    { "op": "request", "process": "job", "port": 1, "session": null,
      "request": { "type": "requestLease", "process": "interactive", "wanted": 9000, "reason": "requested" },
      "expect": { "error": "invalidMessage" } },

    { "op": "request", "process": "job", "port": 1, "session": null,
      "request": { "type": "blenderStatus" },
      "expect": { "error": "unsupported" } },
    { "op": "request", "process": "job", "port": 1, "session": null,
      "request": { "type": "closeSession" },
      "expect": { "error": "invalidMessage" } },

    { "op": "request", "process": "job", "port": 1, "session": 3,
      "request": { "type": "outputDestination", "job": "j6", "choice": { "kind": "agentAutomatic", "suggestedName": "Orphan", "extension": "mov" }, "overwrite": "uniqueName" },
      "expect": { "response": "outputDestination" }, "save": { "out6": "temporary" } },
    { "op": "request", "process": "job", "port": 1, "session": null,
      "request": { "type": "resolveHandle", "handle": "$out6", "session": 3 },
      "expect": { "response": "handleResolved" }, "save": { "out6Path": "path" } },
    { "op": "endLaunch", "process": "job", "port": 1, "expectRemoved": 1 },
    { "op": "exists", "path": "$out6Path", "expect": false },
    { "op": "request", "process": "job", "port": 1, "session": null,
      "request": { "type": "resolveHandle", "handle": "$cacheHandle", "session": 1 },
      "expect": { "error": "capabilityRejected" } },
    { "op": "request", "process": "job", "port": 3, "session": null,
      "request": { "type": "hardwareSessions", "kind": "proResEncode", "delta": 2 },
      "expect": { "response": "hardwareSessions", "fields": { "held": 2 } } },
    { "op": "listOutputs", "expect": ["Cut (2).mov", "Cut.mov"] }
  ]
}
