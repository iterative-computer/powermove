{
  "name": "@powermove/desktop",
  "license": "AGPL-3.0-or-later",
  "version": "1.0.1",
  "private": true,
  "description": "Powermove: a GPU-native, AI-authored motion editor for macOS.",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "svelte-check --tsconfig ./tsconfig.web.json && tsc --noEmit -p tsconfig.node.json",
    "lint:boundaries": "node scripts/check-boundaries.mjs",
    "dist:mac": "electron-vite build && electron-builder --mac && node scripts/create-dmg.mjs",
    "dist:release": "node scripts/release-mac.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-code": "2.1.280",
    "@anthropic-ai/claude-code-darwin-arm64": "2.1.280",
    "@anthropic-ai/claude-agent-sdk": "0.3.280",
    "@lisse/core": "0.7.2",
    "@motion-core/motion-gpu": "0.15.1",
    "@openai/codex": "0.156.0",
    "@openai/codex-darwin-arm64": "npm:@openai/codex@0.156.0-darwin-arm64",
    "@powermove/macos-haptics": "workspace:*",
    "@powermove/player": "workspace:*",
    "@powermove/tokens": "workspace:*",
    "electron-updater": "6.8.3",
    "esbuild": "0.25.12",
    "ffmpeg-static": "5.3.0"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "@playwright/test": "1.62.1",
    "@sveltejs/vite-plugin-svelte": "6.2.4",
    "@types/node": "26.3.0",
    "@types/ws": "^8.18.1",
    "create-dmg": "^8.1.0",
    "electron": "44.0.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "happy-dom": "20.11.6",
    "playwright": "1.62.1",
    "svelte": "5.56.10",
    "svelte-check": "4.7.6",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "4.1.11",
    "ws": "8"
  },
  "engines": {
    "node": ">=22"
  }
}
