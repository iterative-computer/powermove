{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "tsBuildInfoFile": "./node_modules/.tsconfig.web.tsbuildinfo",
    "isolatedModules": true,
    "skipLibCheck": true,
    "types": ["svelte", "vite/client"],
    "baseUrl": ".",
    "paths": { "powermove": ["src/renderer/src/kernel/api.ts"] }
  },
  "include": ["src/renderer/src/**/*.ts", "src/renderer/src/**/*.svelte", "src/renderer/sandbox/**/*.ts", "src/extensions/**/*.ts", "src/extensions/**/*.svelte", "src/shared/**/*.ts"]
}
