{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "tsBuildInfoFile": "./node_modules/.tsconfig.node.tsbuildinfo",
    "isolatedModules": true,
    "skipLibCheck": true,
    "types": ["node", "electron-vite/node"],
    /* The cloud's route types, emitted by `apps/cloud` (`bun run types:emit`,
       also run by this package's `typecheck`). Type-only: main never imports
       cloud runtime code, only `import type { AppType }` for `hc<AppType>`. */
    "paths": { "@powermove/cloud-types": ["../cloud/dist/types/index.d.ts"] }
  },
  "references": [{ "path": "../cloud/tsconfig.types.json" }],
  "include": [
    "electron.vite.config.ts",
    "scripts/player-bundle.ts",
    "src/main/**/*.ts",
    "src/preload/**/*.ts",
    "src/server/**/*.ts",
    "src/engine/document-host/pool.ts",
    "src/engine/document-host/protocol.ts",
    "src/shared/**/*.ts",
    /* canonical-json.test compares the shared format with these pure
       composition helpers; composite projects list every imported source. */
    "src/renderer/src/legacy/core/compositions.ts",
    "src/renderer/src/engine-doc/write.ts",
    "src/renderer/src/legacy/registry.ts",
    "../../engine/crates/pm-model/tests/vectors/generate-patch-binary-vectors.ts"
  ],
  /* The frame bridge harness pages run in a renderer (tsconfig.web.json). */
  "exclude": ["src/server/native/contract-run.ts", "src/main/engine/integration/*-page.ts", "src/main/engine/integration/page-engine.ts", "src/main/engine/integration/synthetic-project.ts", "src/main/engine/integration/bridge-worker.ts"]
}
