{
  "title": "Timing & easing",
  "height": 420,
  "html": "<!doctype html><html><head><style>h1{font-size:20px;margin:0 0 6px}p{color:var(--muted)}svg{display:block;width:100%;height:190px}path{fill:none;stroke:var(--accent);stroke-width:4}label{display:flex;gap:12px;align-items:center}input{width:100%}.track{height:25px;background:color-mix(in srgb,var(--foreground) 8%,transparent);border-radius:6px;margin-top:20px}.dot{width:25px;height:25px;background:var(--accent);border-radius:6px;transform:translateX(0)}</style></head><body><h1>Timing & easing</h1><p>Compare a linear move with a smooth ease-out.</p><svg viewBox=\"0 0 360 180\" role=\"img\" aria-label=\"Ease-out curve\"><path d=\"M10 165 C50 10 130 10 350 10\"/><path d=\"M10 165 L350 10\" style=\"stroke:var(--muted);stroke-width:1;stroke-dasharray:4 4\"/></svg><label>Duration <input aria-label=\"Duration\" type=\"range\" min=\"200\" max=\"2000\" value=\"800\"><output>800 ms</output></label><div class=\"track\"><div class=\"dot\"></div></div><button id=\"play\">Play motion</button><script>const duration=document.querySelector('input'),out=document.querySelector('output');duration.addEventListener('input',()=>out.textContent=duration.value+' ms');document.querySelector('#play').onclick=()=>document.querySelector('.dot').animate([{transform:'translateX(0)'},{transform:'translateX(250px)'}],{duration:+duration.value,easing:'cubic-bezier(.16,1,.3,1)',fill:'forwards'});</script></body></html>"
}
