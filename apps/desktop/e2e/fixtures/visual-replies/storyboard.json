{
  "title": "Launch storyboard",
  "height": 410,
  "html": "<!doctype html><html><head><style>h1{font-size:20px}.frames{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.frame{aspect-ratio:1;background:color-mix(in srgb,var(--accent) 18%,var(--background));display:grid;place-items:center;border-radius:8px;font-size:32px}.shot p{color:var(--muted)}button{background:var(--accent);color:var(--background);border:0;border-radius:5px;padding:8px 12px}.active{outline:2px solid var(--accent)}output{display:block;margin-top:16px}</style></head><body><h1>Launch storyboard</h1><div class=\"frames\"><div class=\"shot\"><div class=\"frame active\">01</div><p>0\u20131s \u00b7 Arrival</p></div><div class=\"shot\"><div class=\"frame\">02</div><p>1\u20132s \u00b7 Reveal</p></div><div class=\"shot\"><div class=\"frame\">03</div><p>2\u20133s \u00b7 Resolve</p></div></div><button>Next shot</button><output>Arrival \u2014 a soft rise from below.</output><script>let n=0;document.querySelector('button').onclick=()=>{n=(n+1)%3;document.querySelectorAll('.frame').forEach((e,i)=>e.classList.toggle('active',i===n));document.querySelector('output').textContent=['Arrival \u2014 a soft rise from below.','Reveal \u2014 title settles as the accent expands.','Resolve \u2014 hold the final composition.'][n]};</script></body></html>"
}
