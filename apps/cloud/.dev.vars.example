# Local development: production.ts refuses to serve with any development setting when ENVIRONMENT=production.
ENVIRONMENT=development
# PostHog events go only from production; POSTHOG_LOCAL=1 sends them from here too (to wrangler.jsonc's project).
# POSTHOG_LOCAL=1
LOCAL_POSTGRES=1
DATABASE_URL=postgres://powermove:powermove@localhost:54329/powermove
BETTER_AUTH_SECRET=local-development-secret-32-characters-long
APP_ORIGIN=http://localhost:8787
# The admin panel (apps/admin, `bun run dev` there). Web sign-in returns only here.
ADMIN_ORIGIN=http://localhost:5174
DEV_LOG_OTP=1
EMAIL_FROM="Powermove <sign-in@trypowermove.com>"

# To enable Google sign-in, start `bun run dev:emulate` in another terminal
# and uncomment these lines. The emulator has Jude and Mara accounts.
# GOOGLE_CLIENT_ID=powermove-local
# GOOGLE_CLIENT_SECRET=powermove-local-secret
# GOOGLE_DISCOVERY_URL=http://localhost:4002/.well-known/openid-configuration

# Local always-pass Turnstile keys override the production widget in wrangler.jsonc.
# These public test keys are accepted only on localhost/127.0.0.1.
TURNSTILE_ENABLED=1
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_CLEARANCE_DAYS=30

# Billing and Aero against the local fakes (`bun run dev:stripe` and `bun run dev:ai`, or all of it with
# `bun run local:billing`). These are fake values; real Stripe and provider keys are Worker secrets only.
STRIPE_SECRET_KEY=sk_test_powermove_local_fake
STRIPE_WEBHOOK_SECRET=whsec_powermove_local_fake
STRIPE_API_BASE=http://localhost:12111
OPENAI_API_KEY=local-simulator
ANTHROPIC_API_KEY=local-simulator
AERO_OPENAI_BASE_URL=http://localhost:4010/openai/v1
AERO_ANTHROPIC_BASE_URL=http://localhost:4010/anthropic/v1
