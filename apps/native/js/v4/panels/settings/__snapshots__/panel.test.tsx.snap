                    text "None"
        div group label="Shared Keys"
          div
            text heading
              text "Shared Keys"
          div group label="Shared Keys"
            div form-group group label="Shared Keys"
              div group settings.shared.alt+shift+s label="⌥⇧S"
                div
                  text
                    text "⌥⇧S"
                  text
                    text "Tried in this order: Add or Remove Scale Keyframe, then Audio Skimming."
Focus: ["Search Commands","Reset","Change the shortcut for Ripple Trim In Point to Playhead","Type a shortcut. Escape cancels.","Change the shortcut for Previous Edge"]"
