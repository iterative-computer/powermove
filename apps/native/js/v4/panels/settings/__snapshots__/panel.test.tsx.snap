                    text "Fixture size"
                div
                  button push-button label="Use"
                    text "Use"
                  button push-button label="Delete…"
                    text "Delete…"
Focus: ["Use","Delete…"]"
`;

exports[`transcription error wire/AX state 1`] = `
"root
  div group settings label="Settings"
    scroll group settings.detail label="Transcription"
      div group settings.section.transcription label="Transcription"
        div group label="Models"
          div
