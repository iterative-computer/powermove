"root
  div group settings label="Settings"
    div
      scroll group settings.detail label="General"
        div
          div
            div group settings.section.general label="General"
              div group label="Appearance"
                text heading
                  text "Appearance"
                div group label="Appearance"
                  div form-group group label="Appearance"
                    div group settings.row.appearance label="Appearance"
                      div
                        div
                          text
                            text "Appearance"
                        text
                          text "Follow your system setting, or pick a light or dark theme."
                      div
              div group label="Workspace"
                text heading
                  text "Workspace"
                div group label="Workspace"
                  div form-group group label="Workspace"
                    div group settings.row.workspace label="After Effects Workspace"
                      div
                        div
                          text
                            text "After Effects Workspace"
                        text
                          text "Bring your saved panels and tools into Powermove with your agent."
                      div
                        button push-button label="Bring My Workspace…"
                          text "Bring My Workspace…"
              div group label="Playback"
                text heading
                  text "Playback"
                div group label="Playback"
                  div form-group group label="Playback"
                    div group settings.row.preview-memory label="Preview Memory Limit"
                      div
                        div
                          text
                            text "Preview Memory Limit"
                        text
                          text "Frames kept in memory so replays are instant."
                      div
              div group label="Media"
                text heading
                  text "Media"
                div group label="Media"
                  div form-group group label="Media"
                    div group settings.row.cloud-media label="Automatically Download Cloud Media"
                      div
                        div
                          text
                            text "Automatically Download Cloud Media"
                        text
                          text "Download offloaded files when opening a project."
                      div
                        button switch switch label="Automatically Download Cloud Media" value=false disabled
              div group label="Windows"
                text heading
                  text "Windows"
                div group label="Windows"
                  div form-group group label="Windows"
                    div group settings.row.open-projects-in label="Open Projects In"
                      div
                        div
                          text
                            text "Open Projects In"
                        text
                          text "Tabs keeps your projects in one window, side by side in the toolbar. Separate Windows gives each project a window of its own."
                      div
                    div
                    div group settings.row.restore-windows label="Reopen Last Project on Launch"
                      div
                        div
                          text
                            text "Reopen Last Project on Launch"
                        text
                          text "Open only the project you were last working on."
                      div
                        button switch switch label="Reopen Last Project on Launch" value=true disabled
Focus: ["Bring My Workspace…"]"
`;

