            text heading
              text "Layer"
            input text-field label="Search Commands" value=""
          div group label="Layer"
            div form-group group label="Layer"
              div group settings.shortcut.rippleTrimIn label="Ripple Trim In Point to Playhead"
                button push-button label="Ripple Trim In Point to Playhead"
                  text "Ripple Trim In Point to Playhead"
                div
                  button push-button label="Reset"
                    text "Reset"
                  button push-button label="Change the shortcut for Ripple Trim In Point to Playhead"
                    text "Q"
              div group settings.shortcut.extendEdit label="Extend Edit to Playhead"
                button push-button label="Extend Edit to Playhead"
                  text "Extend Edit to Playhead"
                div
                  button push-button label="Type a shortcut. Escape cancels."
                    text "Type a shortcut…"
        div group label="Powermove"
          div
            text heading
              text "Powermove"
          div group label="Powermove"
            div form-group group label="Powermove"
              div group settings.shortcut.quit label="Quit Powermove"
                div
                  text
                    text "Quit Powermove"
                div
                  text label="Quit Powermove: macOS's key, not assignable"
                    text "⌘Q"
        div group label="Playback"
          div
            text heading
              text "Playback"
          div group label="Playback"
            div form-group group label="Playback"
              div group settings.shortcut.prevEdge label="Previous Edge"
                button push-button label="Previous Edge"
                  text "Previous Edge"
                div
