{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "jsxImportSource": "powermove-v4",
    "lib": ["ES2022", "DOM"],
    "types": ["bun"],
    "paths": {
      "powermove/ui": ["./src/ui.ts"],
      "powermove-v4/jsx-runtime": ["./src/jsx-runtime.ts"]
    }
  },
  "include": ["src", "test", "eval", "bench.ts"]
}
