{
 "format": "aero-eval-suite",
 "version": 1,
 "tasks": [
  {
   "id": "cut-drop-flubbed-take",
   "kind": "cut",
   "prompt": "Take 2 is the flubbed one. Lose it and close the gap, then move the B-roll so it plays right after Take 1.",
   "fixture": {
    "project": "projects/interview.pmv",
    "extensions": []
   },
   "graders": [
    {
     "grader": "project",
     "assertions": [
      {
       "name": "the flubbed take is gone",
       "count": {
        "select": {
         "name": "Take 2"
        },
        "expect": {
         "eq": 0
        }
       }
      },
      {
       "name": "clips run Take 1, B-roll, Take 3, Take 4",
       "order": {
        "select": {
         "type": "video"
        },
        "names": [
         "Take 1",
         "B-roll",
         "Take 3",
         "Take 4"
        ]
       }
      },
      {
       "name": "no gaps, starting at zero",
       "contiguous": {
        "select": {
         "type": "video"
        },
        "start": 0
       }
      },
      {
       "name": "takes keep their length",
       "field": {
        "select": {
         "type": "video"
        },
        "path": "/dur",
        "expect": {
         "approx": 2,
         "tol": 0.04
        }
       }
      },
      {
       "name": "lower third untouched",
       "unchanged": {
        "select": {
         "name": "Lower third"
        },
        "ignore": [
         "/selected"
        ]
       }
      }
     ]
    }
   ],
   "limits": {
    "wall_secs": 900,
    "steps": 60
   },
   "why": "Delete, ripple and reorder: the basic edit every editor does first."
  },
  {
   "id": "cut-tighten-takes",
   "kind": "cut",
   "prompt": "Tighten every take to its middle second. Drop the first and last half second of each, B-roll included, and keep everything back to back.",
   "fixture": {
    "project": "projects/interview.pmv",
    "extensions": []
   },
   "graders": [
    {
     "grader": "project",
     "assertions": [
      {
       "name": "each clip is one second",
       "field": {
        "select": {
         "type": "video"
        },
        "path": "/dur",
        "expect": {
         "approx": 1,
         "tol": 0.04
        }
       }
      },
      {
       "name": "each clip starts half a second in",
       "field": {
        "select": {
         "type": "video"
        },
        "path": "/d/trim",
        "expect": {
         "approx": 0.5,
         "tol": 0.04
        }
       }
      },
      {
       "name": "order kept",
       "order": {
        "select": {
         "type": "video"
        },
        "names": [
         "Take 1",
         "Take 2",
         "Take 3",
         "B-roll",
         "Take 4"
        ]
       }
      },
      {
       "name": "no gaps, starting at zero",
       "contiguous": {
        "select": {
         "type": "video"
        },
        "start": 0
       }
      }
     ]
    }
   ],
   "limits": {
    "wall_secs": 900,
    "steps": 80
   },
   "why": "Trims on both ends across many clips with a ripple: tests planning a batch edit."
  },
